{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/provider/v1/activate",
    "bodyPatterns": [ { "matchesJsonPath": "$[?(@.productCode =~ /INVALID.*/)]" } ]
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "error": "UNKNOWN_PRODUCT" }
  }
}
