# Copie para .env e ajuste os valores: cp .env.example .env

# Banco de dados (PostgreSQL)
POSTGRES_DB=deroyque
POSTGRES_USER=deroyque
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Aplicação
APP_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Mocks locais (docker compose)
PROVIDER_PORT=8089
OAUTH_PORT=8090

# Credencial do provedor externo (em producao: servico de segredos)
PROVIDER_API_KEY=

# Formato de log: ecs (JSON) ou vazio para texto
LOG_FORMAT=ecs
